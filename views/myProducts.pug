doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    title My Products - Ufarm
  body
    include includes/navbar.pug

    .container.my-5
      include includes/back-button.pug

      .d-flex.justify-content-between.align-items-center.mb-4
        h2
          i.fas.fa-box.me-2.text-primary
          | My Products
        a.btn.btn-success(href='/add-product')
          i.fas.fa-plus-circle.me-2
          | Add New Product

      include includes/flash-messages.pug

      if ufproduces && ufproduces.length
        // Statistics
        .row.mb-4
          .col-md-4.mb-3
            .card.text-center.shadow-sm.border-0
              .card-body
                i.fas.fa-box.fa-2x.text-primary.mb-2
                h4.fw-bold #{ufproduces.length}
                p.text-muted.mb-0 Total Products
          .col-md-4.mb-3
            .card.text-center.shadow-sm.border-0
              .card-body
                i.fas.fa-check-circle.fa-2x.text-success.mb-2
                h4.fw-bold #{ufproduces.filter(p => p.status === 'approved').length}
                p.text-muted.mb-0 Approved
          .col-md-4.mb-3
            .card.text-center.shadow-sm.border-0
              .card-body
                i.fas.fa-clock.fa-2x.text-warning.mb-2
                h4.fw-bold #{ufproduces.filter(p => p.status === 'pending').length}
                p.text-muted.mb-0 Pending

        // Products Grid
        .row.g-4
          each product in ufproduces
            .col-lg-3.col-md-4.col-sm-6
              .card.h-100.shadow-hover.border-0
                .position-relative
                  case product.status
                    when 'approved'
                      .badge.bg-success.position-absolute.top-0.start-0.m-2(style='z-index: 2;') 
                        i.fas.fa-check.me-1
                        | Approved
                    when 'pending'
                      .badge.bg-warning.position-absolute.top-0.start-0.m-2(style='z-index: 2;') 
                        i.fas.fa-clock.me-1
                        | Pending
                    when 'rejected'
                      .badge.bg-danger.position-absolute.top-0.start-0.m-2(style='z-index: 2;') 
                        i.fas.fa-times.me-1
                        | Rejected
                  
                  img.card-img-top(src='/' + product.image alt=product.productName style='height: 200px; object-fit: cover;')
                
                .card-body.d-flex.flex-column
                  h5.card-title.mb-2= product.productName
                  
                  .mb-2
                    h4.text-success.mb-0 UGX #{product.price.toLocaleString()}
                  
                  p.text-muted.small.mb-2
                    i.fas.fa-boxes.me-1
                    | Stock: #{product.quantity}
                  
                  if product.direction
                    p.text-muted.small.mb-2
                      i.fas.fa-map-marker-alt.me-1
                      | #{product.direction}
                  
                  .mt-auto.d-grid.gap-2
                    a.btn.btn-outline-primary.btn-sm(href=`/product-detail/${product._id}`)
                      i.fas.fa-eye.me-1
                      | View Details
                    button.btn.btn-outline-danger.btn-sm(onclick=`deleteProduct('${product._id}')`)
                      i.fas.fa-trash.me-1
                      | Delete
      else
        .text-center.py-5
          i.fas.fa-box-open.fa-5x.text-muted.mb-4
          h3 No Products Yet
          p.text-muted.mb-4 Start by adding your first product to the marketplace
          a.btn.btn-success.btn-lg(href='/add-product')
            i.fas.fa-plus-circle.me-2
            | Add Your First Product

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script.
      function deleteProduct(id) {
        if (confirm('Are you sure you want to delete this product?')) {
          fetch(`/delete-product/${id}`, {
            method: 'DELETE'
          })
          .then(response => {
            if (response.ok) {
              window.location.reload();
            } else {
              alert('Failed to delete product');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('Error deleting product');
          });
        }
      }

