doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    title Add Product - Ufarm
  body
    include includes/navbar.pug

    .container.my-5
      include includes/back-button.pug
      include includes/flash-messages.pug

      .row.justify-content-center
        .col-lg-8
          .card.shadow-sm.border-0
            .card-header.bg-success.text-white
              h4.mb-0
                i.fas.fa-plus-circle.me-2
                | Add New Product
            .card-body.p-4
              p.text-muted.mb-4 Fill in the details below to add a new product to your inventory. Products will be reviewed before appearing on the marketplace.
              
              form(action='/uploads' method='post' enctype='multipart/form-data')
                .row.g-3
                  .col-md-6
                    label.form-label(for='productName')
                      i.fas.fa-tag.me-1
                      | Product Name *
                    input.form-control(type='text' id='productName' name='productName' placeholder='e.g., Organic Tomatoes' required)
                    small.form-text.text-muted Enter a clear, descriptive name
                  
                  .col-md-6
                    label.form-label(for='price')
                      i.fas.fa-money-bill-wave.me-1
                      | Price (UGX) *
                    input.form-control(type='number' id='price' name='price' min='0' step='100' placeholder='e.g., 25000' required)
                    small.form-text.text-muted Price per unit in Uganda Shillings
                  
                  .col-md-6
                    label.form-label(for='quantity')
                      i.fas.fa-boxes.me-1
                      | Quantity *
                    input.form-control(type='number' id='quantity' name='quantity' min='1' placeholder='e.g., 100' required)
                    small.form-text.text-muted Available quantity in stock
                  
                  .col-md-6
                    label.form-label(for='direction')
                      i.fas.fa-map-marker-alt.me-1
                      | Location/Direction
                    input.form-control(type='text' id='direction' name='direction' placeholder='e.g., Kampala District, Uganda')
                    small.form-text.text-muted Where is the product located?
                  
                  .col-12
                    label.form-label(for='description')
                      i.fas.fa-align-left.me-1
                      | Description
                    textarea.form-control(id='description' name='description' rows='4' placeholder='Describe your product, its features, quality, and benefits...')
                    small.form-text.text-muted Provide detailed information to help buyers
                  
                  .col-12
                    label.form-label(for='image')
                      i.fas.fa-camera.me-1
                      | Product Image *
                    .image-upload-container
                      input.form-control(type='file' id='image' name='image' accept='image/*' capture='environment' required)
                      small.form-text.text-muted 
                        | Upload a clear, high-quality image (JPG, PNG, max 5MB). 
                        | You can take a photo directly from your phone camera or choose from gallery.
                      #fileInfo.mt-2(style='display: none;')
                        small.text-muted
                          i.fas.fa-file-image.me-1
                          span#fileName
                          |  (
                          span#fileSize
                          | )
                      // Image Preview
                      #imagePreview.mt-3(style='display: none;')
                        .preview-wrapper(style='position: relative; display: inline-block;')
                          img#preview(src='' alt='Preview' style='max-width: 100%; max-height: 400px; border-radius: 8px; border: 2px solid #e0e0e0; box-shadow: 0 2px 8px rgba(0,0,0,0.1);')
                          button.btn.btn-sm.btn-danger.position-absolute.top-0.end-0.m-2(type='button' id='removeImage' style='display: none;' title='Remove image')
                            i.fas.fa-times
                        p.small.text-success.mt-2.mb-0
                          i.fas.fa-check-circle.me-1
                          | Image preview ready. Submit form to upload.
                  
                  .col-12
                    hr.my-4
                    .d-flex.gap-3
                      button.btn.btn-success.btn-lg.px-5(type='submit')
                        i.fas.fa-upload.me-2
                        | Upload Product
                      a.btn.btn-outline-secondary.btn-lg(href='/UB')
                        i.fas.fa-times.me-2
                        | Cancel

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script.
      // Enhanced Image Upload with Preview
      const imageInput = document.getElementById('image');
      const imagePreview = document.getElementById('imagePreview');
      const preview = document.getElementById('preview');
      const fileInfo = document.getElementById('fileInfo');
      const fileName = document.getElementById('fileName');
      const fileSize = document.getElementById('fileSize');
      const removeImageBtn = document.getElementById('removeImage');
      
      // Maximum file size: 5MB
      const MAX_FILE_SIZE = 5 * 1024 * 1024;
      
      // Format file size
      function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
      }
      
      // Validate file
      function validateFile(file) {
        if (!file) return false;
        
        // Check file size
        if (file.size > MAX_FILE_SIZE) {
          alert('File size exceeds 5MB limit. Please choose a smaller image.');
          imageInput.value = '';
          return false;
        }
        
        // Check file type
        const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
        if (!validTypes.includes(file.type)) {
          alert('Invalid file type. Please upload a JPG, PNG, GIF, or WebP image.');
          imageInput.value = '';
          return false;
        }
        
        return true;
      }
      
      // Show preview
      function showPreview(file) {
        if (!validateFile(file)) return;
        
        const reader = new FileReader();
        reader.onload = function(e) {
          preview.src = e.target.result;
          imagePreview.style.display = 'block';
          removeImageBtn.style.display = 'block';
          
          // Show file info
          fileName.textContent = file.name;
          fileSize.textContent = formatFileSize(file.size);
          fileInfo.style.display = 'block';
        };
        reader.onerror = function() {
          alert('Error reading file. Please try again.');
        };
        reader.readAsDataURL(file);
      }
      
      // Handle file selection
      imageInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          showPreview(file);
        } else {
          hidePreview();
        }
      });
      
      // Remove image
      removeImageBtn.addEventListener('click', function() {
        if (confirm('Remove this image?')) {
          imageInput.value = '';
          hidePreview();
        }
      });
      
      // Hide preview
      function hidePreview() {
        imagePreview.style.display = 'none';
        fileInfo.style.display = 'none';
        removeImageBtn.style.display = 'none';
        preview.src = '';
      }
      
      // Form validation and submission
      const form = document.querySelector('form');
      form.addEventListener('submit', function(e) {
        const file = imageInput.files[0];
        if (!file) {
          e.preventDefault();
          alert('Please select an image to upload.');
          return false;
        }
        
        if (!validateFile(file)) {
          e.preventDefault();
          return false;
        }
        
        const submitBtn = form.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Uploading...';
      });
      
      // Support drag and drop (optional enhancement)
      const uploadContainer = document.querySelector('.image-upload-container');
      if (uploadContainer) {
        uploadContainer.addEventListener('dragover', function(e) {
          e.preventDefault();
          uploadContainer.style.border = '2px dashed #28a745';
        });
        
        uploadContainer.addEventListener('dragleave', function(e) {
          e.preventDefault();
          uploadContainer.style.border = '';
        });
        
        uploadContainer.addEventListener('drop', function(e) {
          e.preventDefault();
          uploadContainer.style.border = '';
          const files = e.dataTransfer.files;
          if (files.length > 0) {
            imageInput.files = files;
            const event = new Event('change', { bubbles: true });
            imageInput.dispatchEvent(event);
          }
        });
      }

