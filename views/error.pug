doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    title Error - Ufarm
  body
    include includes/navbar.pug

    .container.my-5.text-center
      .py-5
        i.fas.fa-exclamation-circle.fa-5x.text-danger.mb-4
        h1.display-3 Oops! Something went wrong
        if error
          .alert.alert-danger.mt-4.text-start(style='max-width: 600px; margin: 0 auto;')
            h5.alert-heading Error Details:
            p.mb-0 #{error.message}
            if error.stack
              hr
              pre.small.mb-0 #{error.stack}
        else
          p.lead.mb-4 We're sorry, but something unexpected happened.
        .mt-4
          a.btn.btn-success.btn-lg(href='/')
            i.fas.fa-home.me-2
            | Go Home

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')

