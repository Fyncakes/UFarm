doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/login.css')
    title Forgot Password - Ufarm
  body
    include includes/navbar.pug

    .container.mt-3
      include includes/flash-messages.pug

    form(action='/forgot-password' method='post')
      h1
        i.fas.fa-key.me-2
        | Forgot Password
      p.text-center.text-muted.mb-4 Enter your email address and we'll send you a link to reset your password

      .mb-3
        label.form-label(for='email')
          i.fas.fa-envelope.me-2
          | Email Address
        input#email.form-control(type='email' name='email' placeholder='Enter your registered email' required)
        small.form-text.text-muted We'll send password reset instructions to this email

      .d-grid.mb-3
        button.btn.btn-primary(type='submit')
          i.fas.fa-paper-plane.me-2
          | Send Reset Link
      
      .text-center
        p.mb-0
          a(href='/login')
            i.fas.fa-arrow-left.me-1
            | Back to Login

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')

