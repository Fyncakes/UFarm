doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    title 404 - Page Not Found - Ufarm
  body
    include includes/navbar.pug

    .container.my-5.text-center
      .py-5
        i.fas.fa-exclamation-triangle.fa-5x.text-warning.mb-4
        h1.display-1 404
        h2.mb-4 Page Not Found
        p.lead.mb-4 The page you are looking for doesn't exist or has been moved.
        .d-flex.gap-3.justify-content-center.flex-wrap
          a.btn.btn-success.btn-lg(href='/')
            i.fas.fa-home.me-2
            | Go Home
          a.btn.btn-outline-success.btn-lg(href='/product')
            i.fas.fa-shopping-basket.me-2
            | Browse Products

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')

