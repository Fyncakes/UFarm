doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/register.css')
    title Sign Up - Ufarm
    style.
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: #f8f9fa;
      }
      .split-container {
        display: flex;
        min-height: 100vh;
        padding-top: 56px;
      }
      .image-side {
        flex: 1;
        background: linear-gradient(135deg, rgba(126, 217, 87, 0.65), rgba(92, 179, 45, 0.65)), 
                    url('/image/pexels-rajukhan-pathan-4840120.jpg') center/cover no-repeat;
        background-blend-mode: multiply;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        padding: 3rem 2rem;
        position: relative;
        overflow-y: auto;
      }
      .image-content {
        text-align: center;
        z-index: 1;
      }
      .image-content h1 {
        font-size: 3rem;
        font-weight: bold;
        text-shadow: 3px 3px 15px rgba(0,0,0,0.7);
        margin-bottom: 1.5rem;
      }
      .image-content p {
        font-size: 1.3rem;
        text-shadow: 2px 2px 10px rgba(0,0,0,0.6);
        line-height: 1.8;
      }
      .form-side {
        flex: 1;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        overflow-y: auto;
      }
      .form-container {
        width: 100%;
        max-width: 480px;
      }
      .register-header {
        text-align: center;
        margin-bottom: 2rem;
      }
      .register-header h2 {
        color: #2d3748;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }
      .register-header p {
        color: #718096;
      }
      .form-control:focus, .form-select:focus {
        border-color: #7ed957;
        box-shadow: 0 0 0 0.2rem rgba(126, 217, 87, 0.25);
      }
      .btn-register {
        background: linear-gradient(135deg, #7ed957, #5cb32d);
        border: none;
        padding: 0.75rem;
        font-weight: 600;
        transition: all 0.3s;
        color: white;
      }
      .btn-register:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(126, 217, 87, 0.4);
      }
      @media (max-width: 992px) {
        .split-container {
          flex-direction: column;
        }
        .image-side {
          min-height: 40vh;
          padding: 2rem 1rem;
        }
        .image-content h1 {
          font-size: 2rem;
        }
        .image-content p {
          font-size: 1rem;
        }
      .form-side {
        padding: 1.5rem 1rem;
        }
      }
      .info-card-overlay {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        padding: 1.5rem;
        margin-top: 2rem;
        max-width: 400px;
        width: 100%;
        transition: all 0.3s;
      }
      .info-card-overlay:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
      }
      .info-card-overlay h6 {
        color: #2d3748;
        font-weight: 600;
      }
      .info-card-overlay p {
        color: #4a5568;
      }
  body
    include includes/navbar.pug

    .split-container
      // Left Side - Image with overlay
      .image-side
        .image-content
          i.fas.fa-leaf.fa-4x.mb-4(style='filter: drop-shadow(3px 3px 10px rgba(0,0,0,0.7));')
          h1 Welcome to Ufarm
          p Fresh from the farm,
          p.mb-0 straight to your table
        
        // Information Cards on Image Side
        .info-card-overlay
          .text-center
            i.fas.fa-tractor.fa-3x.text-success.mb-3
            h6.mb-2 Want to Sell Products?
            p.small.mb-3 Become an Urban Farmer through a Farmer One Agent
            a.btn.btn-success(href='/join-requirements')
              i.fas.fa-arrow-right.me-2
              | Learn More
        
        .info-card-overlay
          .text-center
            i.fas.fa-user-tie.fa-3x.text-primary.mb-3
            h6.mb-2 Want to be an Agent?
            p.small.mb-3 Register farmers in your district as a Farmer One Agent
            a.btn.btn-primary(href='/join-requirements')
              i.fas.fa-arrow-right.me-2
              | Contact Officer
      
      // Right Side - Registration Form
      .form-side
        .form-container
          include includes/back-button.pug
          include includes/flash-messages.pug
          
          .register-header
            i.fas.fa-user-plus.fa-3x.text-success.mb-3
            h2 Create Your Account
            p.mb-0 Join Ufarm today!

          form(action='/Register' method='post')
            .mb-3
              label.form-label(for='Name1')
                i.fas.fa-user.me-1
                | Full Name *
              input#Name1.form-control(name='Name1' type='text' placeholder='Enter your full name' required)
              small.text-muted This will be your login username
            
            .row
              .col-md-6.mb-3
                label.form-label(for='phonenumber')
                  i.fas.fa-phone.me-1
                  | Phone Number *
                input#phonenumber1.form-control(type='tel' name='phonenumber' placeholder='0700000000' required)
              
              .col-md-6.mb-3
                label.form-label(for='Gender1')
                  i.fas.fa-venus-mars.me-1
                  | Gender
                select#Gender1.form-select(name='Gender1')
                  option(value='') Select
                  option(value='Male') Male
                  option(value='Female') Female
                  option(value='Other') Other
            
            .mb-3
              label.form-label(for='Ward1')
                i.fas.fa-map-marker-alt.me-1
                | Location
              input#Ward1.form-control(type='text' name='Ward1' placeholder='District/Ward')
            
            .mb-3
              label.form-label(for='password')
                i.fas.fa-lock.me-1
                | Password *
              .input-group
                input#password.form-control(type='password' name='password' placeholder='Minimum 6 characters' required minlength='6')
                button.btn.btn-outline-secondary(type='button' onclick='togglePassword("password")' style='border-color: #dee2e6;')
                  i#password-icon.fas.fa-eye
            
            input(type='hidden' name='role' value='user')
            
            .mb-3
              .form-check
                input#terms.form-check-input(type='checkbox' required)
                label.form-check-label(for='terms')
                  | I agree to the 
                  a(href='/terms' target='_blank') Terms and Conditions
            
            button.btn.btn-register.w-100.text-white(type='submit')
              i.fas.fa-user-plus.me-2
              | Create Account
          
          .text-center.mt-4.pt-3.border-top
            p.mb-0.text-muted Already have an account? 
              a.fw-bold.text-decoration-none.text-success(href='/login') Login here

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script(src='/js/form_val.js')
    script(src='/js/alert.js')
    script.
      function togglePassword(fieldId) {
        const passwordField = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + '-icon');
        
        if (passwordField.type === 'password') {
          passwordField.type = 'text';
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        } else {
          passwordField.type = 'password';
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      }