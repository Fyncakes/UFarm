doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    title Edit Product - Ufarm
  body
    include includes/navbar.pug

    .container.my-5
      include includes/back-button.pug
      include includes/flash-messages.pug

      .row.justify-content-center
        .col-lg-8
          .card.shadow-sm.border-0
            .card-header.bg-warning.text-dark
              h4.mb-0
                i.fas.fa-edit.me-2
                | Edit Product
            .card-body.p-4
              .alert.alert-warning.mb-4
                i.fas.fa-exclamation-triangle.me-2
                strong Important:
                |  After editing, your product will return to "Pending Review" status and will need to be approved again before appearing on the marketplace.
              
              form(action=`/update-product/${product._id}` method='post' enctype='multipart/form-data')
                .row.g-3
                  .col-md-6
                    label.form-label(for='productName')
                      i.fas.fa-tag.me-1
                      | Product Name *
                    input.form-control(type='text' id='productName' name='productName' value=product.productName required)
                    small.form-text.text-muted Enter a clear, descriptive name
                  
                  .col-md-6
                    label.form-label(for='price')
                      i.fas.fa-money-bill-wave.me-1
                      | Price (UGX) *
                    input.form-control(type='number' id='price' name='price' min='0' step='100' value=product.price required)
                    small.form-text.text-muted Price per unit in Uganda Shillings
                  
                  .col-md-6
                    label.form-label(for='quantity')
                      i.fas.fa-boxes.me-1
                      | Quantity *
                    input.form-control(type='number' id='quantity' name='quantity' min='1' value=product.quantity required)
                    small.form-text.text-muted Available quantity in stock
                  
                  .col-md-6
                    label.form-label(for='category')
                      i.fas.fa-th-large.me-1
                      | Product Category *
                    select.form-select(id='category' name='category' required)
                      option(value='' disabled) -- Select a Category --
                      if categories && categories.length > 0
                        each category in categories
                          option(value=category._id selected=(product.category && product.category._id && product.category._id.toString() === category._id.toString())) #{category.name}
                      else
                        option(value='' disabled) No categories available. Please contact admin.
                    small.form-text.text-muted Choose the most appropriate category for your product
                  
                  .col-md-6
                    label.form-label(for='direction')
                      i.fas.fa-map-marker-alt.me-1
                      | Location/Direction
                    input.form-control(type='text' id='direction' name='direction' value=product.direction || '' placeholder='e.g., Kampala District, Uganda')
                    small.form-text.text-muted Where is the product located?
                  
                  .col-12
                    label.form-label(for='description')
                      i.fas.fa-align-left.me-1
                      | Description
                    textarea.form-control(id='description' name='description' rows='4')= product.description || ''
                    small.form-text.text-muted Provide detailed information to help buyers
                  
                  .col-12
                    .form-check.mb-3
                      input.form-check-input(type='checkbox' id='organic' name='organic' checked=product.organic)
                      label.form-check-label(for='organic')
                        i.fas.fa-leaf.me-1.text-success
                        | Organic Product
                  
                  .col-12
                    label.form-label(for='image')
                      i.fas.fa-camera.me-1
                      | Product Image
                    .image-upload-container
                      input.form-control(type='file' id='image' name='image' accept='image/*' capture='environment')
                      small.form-text.text-muted 
                        | Leave empty to keep current image, or upload a new one (JPG, PNG, max 5MB).
                        | You can take a photo directly from your phone camera or choose from gallery.
                      #fileInfo.mt-2(style='display: none;')
                        small.text-muted
                          i.fas.fa-file-image.me-1
                          span#fileName
                          |  (
                          span#fileSize
                          | )
                      
                      // Current Image Preview
                      if product.image
                        .mt-3.mb-3
                          p.small.text-muted.mb-2
                            i.fas.fa-image.me-1
                            | Current Image:
                          .preview-wrapper(style='position: relative; display: inline-block;')
                            img(src=imageUrl(product.image) alt='Current product' style='max-width: 100%; max-height: 300px; border-radius: 8px; border: 2px solid #e0e0e0; box-shadow: 0 2px 8px rgba(0,0,0,0.1);')
                      
                      // New Image Preview
                      #imagePreview.mt-3(style='display: none;')
                        p.small.text-muted.mb-2
                          i.fas.fa-eye.me-1
                          | New Image Preview:
                        .preview-wrapper(style='position: relative; display: inline-block;')
                          img#preview(src='' alt='Preview' style='max-width: 100%; max-height: 400px; border-radius: 8px; border: 2px solid #e0e0e0; box-shadow: 0 2px 8px rgba(0,0,0,0.1);')
                          button.btn.btn-sm.btn-danger.position-absolute.top-0.end-0.m-2(type='button' id='removeImage' style='display: none;' title='Remove new image')
                            i.fas.fa-times
                        p.small.text-success.mt-2.mb-0
                          i.fas.fa-check-circle.me-1
                          | New image preview ready. Submit form to update.
                  
                  .col-12
                    hr.my-4
                    .d-flex.gap-3
                      button.btn.btn-warning.btn-lg.px-5(type='submit')
                        i.fas.fa-save.me-2
                        | Update Product
                      a.btn.btn-outline-secondary.btn-lg(href='/my-products')
                        i.fas.fa-times.me-2
                        | Cancel

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script.
      // Enhanced Image Upload with Preview
      const imageInput = document.getElementById('image');
      const imagePreview = document.getElementById('imagePreview');
      const preview = document.getElementById('preview');
      const fileInfo = document.getElementById('fileInfo');
      const fileName = document.getElementById('fileName');
      const fileSize = document.getElementById('fileSize');
      const removeImageBtn = document.getElementById('removeImage');
      
      // Maximum file size: 5MB
      const MAX_FILE_SIZE = 5 * 1024 * 1024;
      
      // Format file size
      function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
      }
      
      // Validate file
      function validateFile(file) {
        if (!file) return false;
        
        // Check file size
        if (file.size > MAX_FILE_SIZE) {
          alert('File size exceeds 5MB limit. Please choose a smaller image.');
          imageInput.value = '';
          return false;
        }
        
        // Check file type
        const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
        if (!validTypes.includes(file.type)) {
          alert('Invalid file type. Please upload a JPG, PNG, GIF, or WebP image.');
          imageInput.value = '';
          return false;
        }
        
        return true;
      }
      
      // Show preview
      function showPreview(file) {
        if (!validateFile(file)) return;
        
        const reader = new FileReader();
        reader.onload = function(e) {
          preview.src = e.target.result;
          imagePreview.style.display = 'block';
          removeImageBtn.style.display = 'block';
          
          // Show file info
          fileName.textContent = file.name;
          fileSize.textContent = formatFileSize(file.size);
          fileInfo.style.display = 'block';
        };
        reader.onerror = function() {
          alert('Error reading file. Please try again.');
        };
        reader.readAsDataURL(file);
      }
      
      // Handle file selection
      imageInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          showPreview(file);
        } else {
          hidePreview();
        }
      });
      
      // Remove image
      if (removeImageBtn) {
        removeImageBtn.addEventListener('click', function() {
          if (confirm('Remove this new image?')) {
            imageInput.value = '';
            hidePreview();
          }
        });
      }
      
      // Hide preview
      function hidePreview() {
        imagePreview.style.display = 'none';
        fileInfo.style.display = 'none';
        if (removeImageBtn) removeImageBtn.style.display = 'none';
        preview.src = '';
      }
      
      // Form validation and submission
      const form = document.querySelector('form');
      form.addEventListener('submit', function(e) {
        const file = imageInput.files[0];
        
        // File is optional for edit, but if provided, validate it
        if (file && !validateFile(file)) {
          e.preventDefault();
          return false;
        }
        
        if (confirm('Are you sure you want to update this product? It will need to be reviewed again.')) {
          const submitBtn = form.querySelector('button[type="submit"]');
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Updating...';
        } else {
          e.preventDefault();
        }
      });
      
      // Support drag and drop (optional enhancement)
      const uploadContainer = document.querySelector('.image-upload-container');
      if (uploadContainer) {
        uploadContainer.addEventListener('dragover', function(e) {
          e.preventDefault();
          uploadContainer.style.border = '2px dashed #ffc107';
        });
        
        uploadContainer.addEventListener('dragleave', function(e) {
          e.preventDefault();
          uploadContainer.style.border = '';
        });
        
        uploadContainer.addEventListener('drop', function(e) {
          e.preventDefault();
          uploadContainer.style.border = '';
          const files = e.dataTransfer.files;
          if (files.length > 0) {
            imageInput.files = files;
            const event = new Event('change', { bubbles: true });
            imageInput.dispatchEvent(event);
          }
        });
      }

