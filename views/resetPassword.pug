doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/login.css')
    title Reset Password - Ufarm
  body
    include includes/navbar.pug

    .container.mt-3
      include includes/flash-messages.pug

    form(action=`/reset-password/${token}` method='post')
      h1
        i.fas.fa-lock.me-2
        | Reset Password
      p.text-center.text-muted.mb-4 Enter your new password below

      .mb-3
        label.form-label(for='password')
          i.fas.fa-lock.me-2
          | New Password
        .input-group
          input#password.form-control(type='password' name='password' placeholder='Enter new password' required minlength='6')
          button.btn.btn-outline-secondary(type='button' onclick='togglePassword("password")' style='border-color: #dee2e6;')
            i#password-icon.fas.fa-eye
        small.form-text.text-muted Password must be at least 6 characters long

      .mb-3
        label.form-label(for='confirmPassword')
          i.fas.fa-lock.me-2
          | Confirm Password
        .input-group
          input#confirmPassword.form-control(type='password' name='confirmPassword' placeholder='Confirm new password' required minlength='6')
          button.btn.btn-outline-secondary(type='button' onclick='togglePassword("confirmPassword")' style='border-color: #dee2e6;')
            i#confirmPassword-icon.fas.fa-eye
        small.form-text.text-muted Re-enter your password to confirm

      .d-grid.mb-3
        button.btn.btn-primary(type='submit')
          i.fas.fa-check-circle.me-2
          | Reset Password
      
      .text-center
        p.mb-0
          a(href='/login')
            i.fas.fa-arrow-left.me-1
            | Back to Login

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script.
      function togglePassword(fieldId) {
        const passwordField = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + '-icon');
        
        if (passwordField.type === 'password') {
          passwordField.type = 'text';
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        } else {
          passwordField.type = 'password';
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      }

      // Validate password match
      const form = document.querySelector('form');
      const password = document.getElementById('password');
      const confirmPassword = document.getElementById('confirmPassword');

      form.addEventListener('submit', function(e) {
        if (password.value !== confirmPassword.value) {
          e.preventDefault();
          alert('Passwords do not match. Please try again.');
          confirmPassword.focus();
          return false;
        }
      });

