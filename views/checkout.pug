doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    title Checkout - Ufarm
  body
    include includes/navbar.pug

    .container.my-5
      include includes/back-button.pug
      include includes/flash-messages.pug
      
      h1.mb-4
        i.fas.fa-check-circle.me-2
        | Checkout

      .row
        .col-lg-7
          .card.shadow-sm.mb-4
            .card-body
              h4.card-title.mb-4 Delivery Information
              form(action='/order/place' method='post' id='checkoutForm')
                .mb-3
                  label.form-label(for='deliveryAddress') Delivery Address *
                  textarea.form-control(id='deliveryAddress' name='deliveryAddress' rows='3' required placeholder='Enter your full delivery address')
                
                .mb-3
                  label.form-label(for='deliveryLocation') Location/Landmark
                  input.form-control(type='text' id='deliveryLocation' name='deliveryLocation' placeholder='e.g., Near City Mall')
                
                .mb-3
                  label.form-label(for='paymentMethod') Payment Method *
                  select.form-select(id='paymentMethod' name='paymentMethod' required)
                    option(value='cash_on_delivery') Cash on Delivery
                    option(value='mtn_mobile_money') MTN Mobile Money
                    option(value='airtel_mobile_money') Airtel Mobile Money
                    option(value='bank_transfer') Bank Transfer
                
                // Mobile Money Details (shown when MTN or Airtel is selected)
                #mobileMoneyDetails.mb-3(style='display: none;')
                  .card.bg-light.border
                    .card-body
                      h6.mb-3
                        i.fas.fa-mobile-alt.me-2.text-primary
                        | Mobile Money Details
                      .mb-3
                        label.form-label(for='mobileMoneyPhone') Mobile Money Phone Number *
                        input.form-control(type='tel' id='mobileMoneyPhone' name='mobileMoneyPhone' placeholder='e.g., 0751082492' pattern='[0-9]{9,10}')
                        small.form-text.text-muted Enter your MTN or Airtel mobile money number
                      .alert.alert-info.mb-0
                        i.fas.fa-info-circle.me-2
                        | You will receive a payment request on your phone. Please complete the payment to confirm your order.
                
                .mb-3
                  label.form-label(for='notes') Additional Notes
                  textarea.form-control(id='notes' name='notes' rows='2' placeholder='Any special instructions for delivery')
                
                .mb-3.form-check
                  input#agreeTerms.form-check-input(type='checkbox' required)
                  label.form-check-label(for='agreeTerms')
                    | I agree to the 
                    a(href='/terms' target='_blank') Terms and Conditions
                
                .d-grid.gap-2.d-md-flex.justify-content-md-end
                  a.btn.btn-outline-secondary(href='/cart')
                    i.fas.fa-arrow-left.me-2
                    | Back to Cart
                  button.btn.btn-success(type='submit')
                    i.fas.fa-check.me-2
                    | Place Order

        .col-lg-5
          .card.shadow-sm
            .card-body
              h4.card-title.mb-4 Order Summary
              if cart && cart.items
                .order-items
                  each item in cart.items
                    .d-flex.mb-3.pb-3.border-bottom
                      img.rounded(src=imageUrl(item.image) alt=item.productName style='width: 60px; height: 60px; object-fit: cover;')
                      .ms-3.flex-grow-1
                        h6.mb-1 #{item.productName}
                        p.text-muted.small.mb-0 Qty: #{item.quantity} × UGX #{item.price.toLocaleString()}
                      .text-end
                        strong UGX #{(item.price * item.quantity).toLocaleString()}
                
                hr
                .d-flex.justify-content-between.mb-2
                  span Total Items:
                  strong #{cart.totalItems}
                .d-flex.justify-content-between.mb-3
                  h5 Total:
                  h5.text-success UGX #{cart.totalPrice.toLocaleString()}

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script.
      // Show/hide mobile money details based on payment method
      const paymentMethod = document.getElementById('paymentMethod');
      const mobileMoneyDetails = document.getElementById('mobileMoneyDetails');
      const mobileMoneyPhone = document.getElementById('mobileMoneyPhone');
      
      paymentMethod.addEventListener('change', function() {
        const selectedMethod = this.value;
        if (selectedMethod === 'mtn_mobile_money' || selectedMethod === 'airtel_mobile_money') {
          mobileMoneyDetails.style.display = 'block';
          mobileMoneyPhone.required = true;
        } else {
          mobileMoneyDetails.style.display = 'none';
          mobileMoneyPhone.required = false;
          mobileMoneyPhone.value = '';
        }
      });
      
      // Form validation
      const checkoutForm = document.getElementById('checkoutForm');
      checkoutForm.addEventListener('submit', function(e) {
        const selectedMethod = paymentMethod.value;
        const phoneValue = mobileMoneyPhone.value.trim();
        
        // Validate mobile money phone number if mobile money is selected
        if ((selectedMethod === 'mtn_mobile_money' || selectedMethod === 'airtel_mobile_money')) {
          if (!phoneValue) {
            e.preventDefault();
            alert('Please enter your mobile money phone number.');
            mobileMoneyPhone.focus();
            return false;
          }
          
          // Validate phone number format (Uganda: 9-10 digits)
          const phoneRegex = /^[0-9]{9,10}$/;
          if (!phoneRegex.test(phoneValue)) {
            e.preventDefault();
            alert('Please enter a valid mobile money phone number (9-10 digits).');
            mobileMoneyPhone.focus();
            return false;
          }
        }
        
        // Show loading state
        const submitBtn = checkoutForm.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Processing...';
      });

