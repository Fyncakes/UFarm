doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(http-equiv='X-UA-Compatible' content='IE=edge')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    link(rel='stylesheet' href='/css/profile.css')
    title= isOwnProfile ? 'My Profile - Ufarm' : (user ? `${user.Name1}'s Profile - Ufarm` : 'Profile - Ufarm')
  body
    include includes/navbar.pug

    .container.my-5
      include includes/back-button.pug
      if !isOwnProfile && user
        .alert.alert-info.mb-4
          i.fas.fa-info-circle.me-2
          | You are viewing #{user.Name1}'s profile
      .row
        // Sidebar
        .col-md-3.mb-4
          .card.shadow-sm.border-0
            .card-body.text-center
              if user && user.profileImage
                img.profile-avatar.mb-3(src=imageUrl(user.profileImage) alt='Profile')
              else
                .profile-avatar-placeholder.mb-3
                  i.fas.fa-user.fa-3x.text-muted
              
              h4.mb-1= user ? user.Name1 : 'Guest'
              if user && user.role
                p.badge.bg-success.mb-3= user.role
              if user && user.verified
                p.badge.bg-primary.mb-2
                  i.fas.fa-check-circle.me-1
                  | Verified
              
              if user && user.rating
                .rating.mb-3
                  each star in [1,2,3,4,5]
                    if star <= user.rating
                      i.fas.fa-star.text-warning
                    else
                      i.far.fa-star.text-warning
                  p.small.text-muted.mt-1 #{user.rating}/5.0 Rating
              
              hr
              
              if isOwnProfile
                .d-grid.gap-2
                  a.btn.btn-outline-primary(href='#accountInfo')
                    i.fas.fa-user-circle.me-2
                    | Account Info
                  a.btn.btn-outline-success(href='/orders')
                    i.fas.fa-shopping-bag.me-2
                    | My Orders
                  a.btn.btn-outline-warning(href='/wishlist')
                    i.fas.fa-heart.me-2
                    | Wishlist
                  if user && (user.role === 'Urban farmer' || user.role === 'Farmer one')
                    a.btn.btn-outline-info(href='/UB')
                      i.fas.fa-tractor.me-2
                      | My Products
                  a.btn.btn-outline-danger(href='/logout')
                    i.fas.fa-sign-out-alt.me-2
                    | Logout
              else
                .d-grid.gap-2
                  a.btn.btn-outline-primary(href='#accountInfo')
                    i.fas.fa-user-circle.me-2
                    | View Profile
                  if user && (user.role === 'Urban farmer' || user.role === 'Farmer one')
                    a.btn.btn-outline-info(href=`/product?farmer=${user._id}`)
                      i.fas.fa-seedling.me-2
                      | View Products
                  a.btn.btn-outline-secondary(href='/profile')
                    i.fas.fa-user.me-2
                    | My Profile

        // Main Content
        .col-md-9
          // Account Information
          #accountInfo.card.shadow-sm.border-0.mb-4
            .card-header.bg-success.text-white
              h5.mb-0
                i.fas.fa-user-edit.me-2
                | Account Information
            .card-body
              include includes/flash-messages.pug
              
              if isOwnProfile
                form#profileForm(method='POST' action='/profile/update' enctype='multipart/form-data')
                  .row.g-2
                    .col-md-6
                      label.form-label(for='Name1') Full Name
                      input#Name1.form-control(type='text' name='Name1' value=user ? user.Name1 : '' disabled)
                      small.text-muted Username cannot be changed
                    .col-md-6
                      label.form-label(for='email') Email
                      input#email.form-control(type='email' name='email' value=user ? user.email : '')
                    .col-md-6
                      label.form-label(for='phonenumber') Phone Number *
                      input#phonenumber.form-control(type='tel' name='phonenumber' value=user ? user.phonenumber : '' required)
                    .col-md-6
                      label.form-label(for='Gender1') Gender
                      select#Gender1.form-select(name='Gender1')
                        option(value='Male' selected=user && user.Gender1 === 'Male') Male
                        option(value='Female' selected=user && user.Gender1 === 'Female') Female
                        option(value='Other' selected=user && user.Gender1 === 'Other') Other
                    .col-md-6
                      label.form-label(for='Ward1') Ward/District
                      input#Ward1.form-control(type='text' name='Ward1' value=user ? user.Ward1 : '')
                    .col-md-6
                      label.form-label(for='Nin1') National ID (NIN)
                      input#Nin1.form-control(type='text' name='Nin1' value=user ? user.Nin1 : '')
                    .col-md-4
                      label.form-label(for='address') Address
                      input#address.form-control(type='text' name='address' value=user ? user.address : '')
                    .col-md-4
                      label.form-label(for='district') District
                      input#district.form-control(type='text' name='district' value=user ? user.district : '')
                    .col-md-4
                      label.form-label(for='village') Village
                      input#village.form-control(type='text' name='village' value=user ? user.village : '')
                    if user && (user.role === 'Urban farmer' || user.role === 'Farmer one')
                      .col-md-4
                        label.form-label(for='farmSize') Farm Size (acres)
                        input#farmSize.form-control(type='number' name='farmSize' value=user.farmSize || '' step='0.01')
                      .col-md-4
                        label.form-label(for='farmType') Farm Type
                        select#farmType.form-select(name='farmType')
                          option(value='') Select farm type
                          option(value='crops' selected=user.farmType === 'crops') Crops
                          option(value='livestock' selected=user.farmType === 'livestock') Livestock
                          option(value='mixed' selected=user.farmType === 'mixed') Mixed
                          option(value='poultry' selected=user.farmType === 'poultry') Poultry
                          option(value='dairy' selected=user.farmType === 'dairy') Dairy
                      .col-md-4
                        label.form-label(for='farmLocation') Farm Location
                        input#farmLocation.form-control(type='text' name='farmLocation' value=user.farmLocation || '')
                    .col-12
                      label.form-label(for='bio') Bio
                      textarea#bio.form-control(name='bio' rows='2' placeholder='Tell us about yourself')= user ? user.bio : ''
                    .col-12
                      label.form-label(for='profileImage') Profile Picture
                      input#profileImage.form-control(type='file' name='profileImage' accept='image/*' capture='user')
                      small.text-muted Upload a profile picture (JPG, PNG, max 5MB)
                      #imagePreview.mt-2(style='display: none;')
                        img#preview(src='' alt='Preview' style='max-width: 150px; max-height: 150px; border-radius: 50%; border: 2px solid #28a745;')
                    .col-12.mt-3
                      button.btn.btn-success(type='submit')
                        i.fas.fa-save.me-2
                        | Save Changes
                      button.btn.btn-outline-secondary.ms-2(type='reset')
                        i.fas.fa-undo.me-2
                        | Reset
              else
                // Read-only view for other users
                .row.g-3
                  .col-md-6
                    label.form-label
                      i.fas.fa-user.me-1
                      | Full Name
                    p.form-control-plaintext.border-bottom.pb-2= user ? user.Name1 : 'N/A'
                  
                  .col-md-6
                    label.form-label
                      i.fas.fa-envelope.me-1
                      | Email
                    p.form-control-plaintext.border-bottom.pb-2= user && user.email ? user.email : 'Not provided'
                  
                  .col-md-6
                    label.form-label
                      i.fas.fa-phone.me-1
                      | Phone Number
                    p.form-control-plaintext.border-bottom.pb-2= user && user.phonenumber ? user.phonenumber : 'Not provided'
                  
                  .col-md-6
                    label.form-label
                      i.fas.fa-venus-mars.me-1
                      | Gender
                    p.form-control-plaintext.border-bottom.pb-2= user && user.Gender1 ? user.Gender1 : 'Not specified'
                  
                  .col-md-6
                    label.form-label
                      i.fas.fa-map-marker-alt.me-1
                      | Ward/District
                    p.form-control-plaintext.border-bottom.pb-2= user && user.Ward1 ? user.Ward1 : 'Not provided'
                  
                  .col-md-6
                    label.form-label
                      i.fas.fa-id-card.me-1
                      | National ID (NIN)
                    p.form-control-plaintext.border-bottom.pb-2= user && user.Nin1 ? user.Nin1 : 'Not provided'
                  
                  .col-md-4
                    label.form-label
                      i.fas.fa-home.me-1
                      | Address
                    p.form-control-plaintext.border-bottom.pb-2= user && user.address ? user.address : 'Not provided'
                  
                  .col-md-4
                    label.form-label
                      i.fas.fa-map.me-1
                      | District
                    p.form-control-plaintext.border-bottom.pb-2= user && user.district ? user.district : 'Not provided'
                  
                  .col-md-4
                    label.form-label
                      i.fas.fa-map-pin.me-1
                      | Village
                    p.form-control-plaintext.border-bottom.pb-2= user && user.village ? user.village : 'Not provided'
                  
                  if user && (user.role === 'Urban farmer' || user.role === 'Farmer one')
                    .col-md-6
                      label.form-label
                        i.fas.fa-ruler-combined.me-1
                        | Farm Size (acres)
                      p.form-control-plaintext.border-bottom.pb-2= user.farmSize ? `${user.farmSize} acres` : 'Not provided'
                    
                    .col-md-6
                      label.form-label
                        i.fas.fa-leaf.me-1
                        | Farm Type
                      p.form-control-plaintext.border-bottom.pb-2= user.farmType ? user.farmType.charAt(0).toUpperCase() + user.farmType.slice(1) : 'Not provided'
                    
                    .col-12
                      label.form-label
                        i.fas.fa-map-marker-alt.me-1
                        | Farm Location
                      p.form-control-plaintext.border-bottom.pb-2= user.farmLocation ? user.farmLocation : 'Not provided'
                  
                  .col-12
                    label.form-label
                      i.fas.fa-info-circle.me-1
                      | Bio
                    p.form-control-plaintext.border-bottom.pb-2= user && user.bio ? user.bio : 'No bio available'

          // Statistics Card (for farmers)
          if user && (user.role === 'Urban farmer' || user.role === 'Farmer one')
            .card.shadow-sm.border-0.mb-4
              .card-header.bg-info.text-white
                h5.mb-0
                  i.fas.fa-chart-line.me-2
                  | My Statistics
              .card-body
                .row.text-center
                  .col-md-4
                    .stat-card
                      i.fas.fa-box-open.fa-3x.text-success.mb-2
                      h3.mb-0= user.totalSales || 0
                      p.text-muted Products Sold
                  .col-md-4
                    .stat-card
                      i.fas.fa-money-bill-wave.fa-3x.text-warning.mb-2
                      h3.mb-0 UGX #{user.totalOrders ? user.totalOrders.toLocaleString() : 0}
                      p.text-muted Total Revenue
                  .col-md-4
                    .stat-card
                      i.fas.fa-star.fa-3x.text-info.mb-2
                      h3.mb-0 #{user.rating || 0}/5
                      p.text-muted Average Rating

          // Security Settings (only for own profile)
          if isOwnProfile
            .card.shadow-sm.border-0
              .card-header.bg-warning.text-dark
                h5.mb-0
                  i.fas.fa-lock.me-2
                  | Security Settings
              .card-body
                form#securityForm(method='POST' action='/profile/change-password')
                .row.g-3
                  .col-md-12
                    label.form-label(for='currentPassword')
                      i.fas.fa-key.me-1
                      | Current Password
                    input#currentPassword.form-control(type='password' name='currentPassword' required)
                  
                  .col-md-6
                    label.form-label(for='newPassword')
                      i.fas.fa-lock.me-1
                      | New Password
                    input#newPassword.form-control(type='password' name='newPassword' required minlength='6')
                  
                  .col-md-6
                    label.form-label(for='confirmPassword')
                      i.fas.fa-lock.me-1
                      | Confirm Password
                    input#confirmPassword.form-control(type='password' name='confirmPassword' required minlength='6')
                  
                  .col-12
                    button.btn.btn-warning.btn-lg.px-4(type='submit')
                      i.fas.fa-shield-alt.me-2
                      | Update Password

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script(src='/js/profile.js')

