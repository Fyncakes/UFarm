doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    title Terms and Conditions - Ufarm
  body
    include includes/navbar.pug

    .container.my-5
      include includes/back-button.pug
      .text-center.mb-5
        h1.display-4 Terms and 
          strong.text-success Conditions
        p.lead Last updated: #{new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}

      .row
        .col-lg-10.mx-auto
          .card.shadow-sm.border-0
            .card-body.p-5
              
              // Introduction
              section.mb-5
                h3.mb-3
                  i.fas.fa-info-circle.text-success.me-2
                  | Introduction
                p Welcome to Ufarm, an e-commerce platform connecting farmers, buyers, and sellers across Uganda. By accessing and using our platform, you agree to be bound by these Terms and Conditions. Please read them carefully.

              // Acceptance of Terms
              section.mb-5
                h3.mb-3
                  i.fas.fa-check-circle.text-success.me-2
                  | Acceptance of Terms
                p By registering an account, browsing products, making purchases, or using any services provided by Ufarm, you acknowledge that you have read, understood, and agree to be bound by these Terms and Conditions and our Privacy Policy.

              // User Accounts
              section.mb-5
                h3.mb-3
                  i.fas.fa-user-shield.text-success.me-2
                  | User Accounts
                h5.mt-4 Account Registration
                ul
                  li You must provide accurate, current, and complete information during registration
                  li You are responsible for maintaining the confidentiality of your account credentials
                  li You must notify us immediately of any unauthorized use of your account
                  li One person or entity may maintain only one account
                  li You must be at least 18 years old to create an account
                
                h5.mt-4 Account Types
                ul
                  li <strong>Buyers/Customers:</strong> Can browse, purchase, and review products
                  li <strong>Urban Farmers:</strong> Must be verified by Farmer One Agents to sell products
                  li <strong>Farmer One Agents:</strong> Must be registered by Agriculture Officers
                  li <strong>Agriculture Officers:</strong> System administrators with full platform oversight

              // Product Listings and Sales
              section.mb-5
                h3.mb-3
                  i.fas.fa-shopping-basket.text-success.me-2
                  | Product Listings and Sales
                h5.mt-4 For Sellers (Farmers)
                ul
                  li All products must be accurately described with correct pricing
                  li Products must meet quality standards and be verified before listing
                  li You are responsible for product quality, freshness, and delivery
                  li Organic products must meet organic certification standards
                  li False or misleading product information is prohibited
                
                h5.mt-4 For Buyers
                ul
                  li Product descriptions, images, and prices are provided by sellers
                  li Ufarm verifies products but does not guarantee specific product characteristics
                  li You are responsible for reviewing product details before purchase
                  li Prices are in Ugandan Shillings (UGX) unless otherwise stated

              // Orders and Payments
              section.mb-5
                h3.mb-3
                  i.fas.fa-credit-card.text-success.me-2
                  | Orders and Payments
                ul
                  li All orders are subject to product availability
                  li Payment must be completed before order processing
                  li We accept mobile money and other approved payment methods
                  li Orders cannot be cancelled once payment is confirmed without seller approval
                  li Refunds are subject to our refund policy and seller agreement

              // Delivery and Shipping
              section.mb-5
                h3.mb-3
                  i.fas.fa-truck.text-success.me-2
                  | Delivery and Shipping
                ul
                  li Delivery times and costs are determined by sellers
                  li Buyers are responsible for providing accurate delivery addresses
                  li Risk of loss transfers to buyer upon delivery
                  li Delays due to circumstances beyond our control are not our responsibility
                  li Contact the seller directly for delivery-related inquiries

              // Verification and Quality Assurance
              section.mb-5
                h3.mb-3
                  i.fas.fa-certificate.text-success.me-2
                  | Verification and Quality Assurance
                ul
                  li All farmers and products undergo verification by Agriculture Officers
                  li Organic products are verified for compliance with organic standards
                  li Ufarm reserves the right to remove products that do not meet quality standards
                  li False claims about product quality or certification are prohibited

              // Prohibited Activities
              section.mb-5
                h3.mb-3
                  i.fas.fa-ban.text-danger.me-2
                  | Prohibited Activities
                p You agree NOT to:
                ul
                  li Use the platform for any illegal or unauthorized purpose
                  li Post false, misleading, or fraudulent information
                  li Infringe on intellectual property rights
                  li Harass, abuse, or harm other users
                  li Attempt to gain unauthorized access to the platform
                  li Use automated systems to access the platform without permission
                  li Interfere with or disrupt the platform's operation
                  li Sell prohibited or illegal products

              // Intellectual Property
              section.mb-5
                h3.mb-3
                  i.fas.fa-copyright.text-success.me-2
                  | Intellectual Property
                ul
                  li All content on Ufarm (logos, text, graphics, etc.) is owned by Ufarm
                  li Product images and descriptions are owned by respective sellers
                  li You may not reproduce, distribute, or create derivative works without permission
                  li User-generated content remains your property but grants Ufarm usage rights

              // Limitation of Liability
              section.mb-5
                h3.mb-3
                  i.fas.fa-shield-alt.text-success.me-2
                  | Limitation of Liability
                p Ufarm provides the platform "as is" and makes no warranties about:
                ul
                  li Product quality, safety, or legality
                  li Accuracy of product descriptions
                  li Seller ability to complete transactions
                  li Platform availability or error-free operation
                p Ufarm is not liable for any indirect, incidental, or consequential damages arising from platform use.

              // Dispute Resolution
              section.mb-5
                h3.mb-3
                  i.fas.fa-gavel.text-success.me-2
                  | Dispute Resolution
                ul
                  li Disputes between buyers and sellers should first be resolved directly
                  li Agriculture Officers may mediate disputes when necessary
                  li Ufarm reserves the right to suspend accounts involved in disputes
                  li Legal disputes will be resolved according to Ugandan law

              // Account Termination
              section.mb-5
                h3.mb-3
                  i.fas.fa-user-times.text-danger.me-2
                  | Account Termination
                p Ufarm reserves the right to:
                ul
                  li Suspend or terminate accounts that violate these terms
                  li Remove products that don't meet quality standards
                  li Refuse service to anyone at any time
                  li Modify or discontinue the platform with notice

              // Changes to Terms
              section.mb-5
                h3.mb-3
                  i.fas.fa-edit.text-success.me-2
                  | Changes to Terms
                p We reserve the right to modify these Terms and Conditions at any time. Changes will be effective immediately upon posting. Continued use of the platform after changes constitutes acceptance of the new terms.

              // Contact Information
              section.mb-5
                h3.mb-3
                  i.fas.fa-envelope.text-success.me-2
                  | Contact Information
                p If you have questions about these Terms and Conditions, please contact us:
                ul
                  li Email: support@ufarm.com
                  li Phone: +256 XXX XXX XXX
                  li Address: Kampala, Uganda

              // Governing Law
              section.mb-5
                h3.mb-3
                  i.fas.fa-balance-scale.text-success.me-2
                  | Governing Law
                p These Terms and Conditions are governed by the laws of Uganda. Any disputes will be resolved in the courts of Uganda.

              hr.my-5

              .text-center
                p.text-muted By using Ufarm, you acknowledge that you have read and agree to these Terms and Conditions.
                a.btn.btn-success.btn-lg.mt-3(href='/')
                  i.fas.fa-home.me-2
                  | Return to Home

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')

