doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    title Shopping Cart - Ufarm
  body
    include includes/navbar.pug

    .container.my-5
      include includes/back-button.pug
      h1.mb-4
        i.fas.fa-shopping-cart.me-2
        | Shopping Cart

      if success_msg
        .alert.alert-success.alert-dismissible.fade.show(role='alert')
          | #{success_msg}
          button.btn-close(type='button' data-bs-dismiss='alert')
      
      if error_msg
        .alert.alert-danger.alert-dismissible.fade.show(role='alert')
          | #{error_msg}
          button.btn-close(type='button' data-bs-dismiss='alert')

      if cart && cart.items.length > 0
        .row
          .col-lg-8
            .card.shadow-sm
              .card-body
                each item in cart.items
                  .row.cart-item.mb-3.pb-3.border-bottom
                    .col-md-2.col-3
                      img.img-fluid.rounded(src='/' + item.image alt=item.productName)
                    .col-md-4.col-9
                      h5 #{item.productName}
                      p.text-muted.mb-1 Seller: #{item.seller_name}
                      p.fw-bold.text-success UGX #{item.price.toLocaleString()}
                    .col-md-3.col-6.mt-2.mt-md-0
                      .input-group
                        button.btn.btn-outline-secondary.btn-sm(onclick=`updateQuantity('${item._id}', ${item.quantity - 1})`)
                          i.fas.fa-minus
                        input.form-control.form-control-sm.text-center(type='number' value=item.quantity min='1' id=`qty-${item._id}` readonly)
                        button.btn.btn-outline-secondary.btn-sm(onclick=`updateQuantity('${item._id}', ${item.quantity + 1})`)
                          i.fas.fa-plus
                    .col-md-3.col-6.mt-2.mt-md-0.text-end
                      p.fw-bold.mb-2 UGX #{(item.price * item.quantity).toLocaleString()}
                      form(action=`/cart/remove/${item._id}` method='post' style='display: inline;')
                        button.btn.btn-sm.btn-outline-danger(type='submit')
                          i.fas.fa-trash.me-1
                          | Remove

          .col-lg-4.mt-4.mt-lg-0
            .card.shadow-sm
              .card-body
                h4.card-title Order Summary
                hr
                .d-flex.justify-content-between.mb-2
                  span Total Items:
                  strong #{cart.totalItems}
                .d-flex.justify-content-between.mb-3
                  span Total Price:
                  strong.text-success UGX #{cart.totalPrice.toLocaleString()}
                hr
                a.btn.btn-success.w-100.mb-2(href='/checkout')
                  i.fas.fa-check-circle.me-2
                  | Proceed to Checkout
                form(action='/cart/clear' method='post')
                  button.btn.btn-outline-secondary.w-100(type='submit')
                    i.fas.fa-trash.me-2
                    | Clear Cart

      else
        .text-center.py-5
          i.fas.fa-shopping-cart.fa-5x.text-muted.mb-3
          h3 Your cart is empty
          p.text-muted Start shopping to add items to your cart
          a.btn.btn-success.btn-lg(href='/product')
            i.fas.fa-shopping-basket.me-2
            | Browse Products

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script.
      function updateQuantity(itemId, newQty) {
        if (newQty < 1) return;
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/cart/update/${itemId}`;
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'quantity';
        input.value = newQty;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      }

