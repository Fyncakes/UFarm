doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/dashboard.css')
    title All Products - Agriculture Officer
  body
    include includes/navbar.pug

    .container.my-4
      include includes/back-button.pug
      include includes/flash-messages.pug
      
      .d-flex.justify-content-between.align-items-center.mb-4
        h2
          i.fas.fa-box.me-2.text-warning
          | All Products
        a.btn.btn-primary(href='/OA')
          i.fas.fa-home.me-2
          | Back to Dashboard

      // Filter buttons
      .btn-group.mb-4(role='group')
        a.btn.btn-outline-secondary(href='/OA/products' class=!filter || filter === 'all' ? 'active' : '') All
        a.btn.btn-outline-warning(href='/OA/products?filter=pending' class=filter === 'pending' ? 'active' : '') Pending
        a.btn.btn-outline-success(href='/OA/products?filter=approved' class=filter === 'approved' ? 'active' : '') Approved
        a.btn.btn-outline-danger(href='/OA/products?filter=rejected' class=filter === 'rejected' ? 'active' : '') Rejected

      .row.g-4#productsList
        if products && products.length
          each product in products
            .col-md-4.product-item(data-status=product.status)
              .card.h-100.shadow-sm
                img.card-img-top(src='/' + product.image alt=product.productName style='height: 200px; object-fit: cover;')
                .card-body
                  h5.card-title #{product.productName}
                  p.card-text
                    strong Price: 
                    span.text-success UGX #{product.price.toLocaleString()}
                  p.card-text
                    strong Quantity: 
                    | #{product.quantity}
                  p.card-text
                    strong Owner: 
                    | #{product.owner_name}
                  span.badge(class=`${product.status === 'pending' ? 'bg-warning' : product.status === 'approved' ? 'bg-success' : 'bg-danger'}`) #{product.status}
                .card-footer.bg-transparent
                  if product.status === 'pending'
                    form(action='/OA/approve-product' method='post' style='display: inline;')
                      input(type='hidden' name='productId' value=product._id)
                      button.btn.btn-sm.btn-success(type='submit')
                        i.fas.fa-check.me-1
                        | Approve
                    a.btn.btn-sm.btn-danger(href=`/OA/reject-product/${product._id}?filter=${filter || 'all'}` onclick='return confirm("Reject this product?")')
                      i.fas.fa-times.me-1
                      | Reject
                  else
                    a.btn.btn-sm.btn-info(href=`/product-detail/${product._id}`)
                      i.fas.fa-eye.me-1
                      | View Details
        else
          .col-12
            .text-center.py-5
              i.fas.fa-box-open.fa-4x.text-muted.mb-3
              h4.text-muted No products available
              p.text-muted Products will appear here once farmers upload them

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script.
      function filterProducts(status) {
        const items = document.querySelectorAll('.product-item');
        const buttons = document.querySelectorAll('.btn-group button');
        
        buttons.forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');
        
        items.forEach(item => {
          if (status === 'all' || item.dataset.status === status) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      }
      

