doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/login.css')
    title Login - Ufarm
  body
    include includes/navbar.pug

    .container.mt-3
      include includes/flash-messages.pug

    form(action='/login' method='post') 
      h1
        i.fas.fa-sign-in-alt.me-2
        | Login to Ufarm
      p.text-center.text-muted.mb-4 Welcome back! Please login to your account

      .mb-3
        label.form-label(for='Name1')
          i.fas.fa-user.me-2
          | Username
        input#Name1.form-control(type='text' name='Name1' aria-describedby='usernameHelp' placeholder='Enter your username' required)
        #usernameHelp.form-text Enter the name you used during registration
      
      .mb-3
        label.form-label(for='password')
          i.fas.fa-lock.me-2
          | Password
        .input-group
          input#password.form-control(type='password' name='password' placeholder='Enter your password' required)
          button.btn.btn-outline-secondary(type='button' onclick='togglePassword("password")' style='border-color: #dee2e6;')
            i#password-icon.fas.fa-eye
      
      .mb-3.form-check
        input#rememberMe.form-check-input(type='checkbox')
        label.form-check-label(for='rememberMe') Remember me
      
      .d-grid.mb-3
        button.btn.btn-primary(type='submit')
          i.fas.fa-sign-in-alt.me-2
          | Login
      
      .text-center
        p.mb-2
          a(href='#') Forgot password?
        p Don't have an account? 
          a(href='/Register') Sign up here

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script(src='/js/form_val.js')
    script.
      function togglePassword(fieldId) {
        const passwordField = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + '-icon');
        
        if (passwordField.type === 'password') {
          passwordField.type = 'text';
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        } else {
          passwordField.type = 'password';
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      }