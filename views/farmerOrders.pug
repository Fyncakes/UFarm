doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/main.css')
    title My Orders - Ufarm
  body
    include includes/navbar.pug

    .container.my-5
      include includes/back-button.pug

      .d-flex.justify-content-between.align-items-center.mb-4
        h2
          i.fas.fa-shopping-bag.me-2.text-success
          | My Orders
        .btn-group(role='group')
          button.btn.btn-outline-success.active(data-filter='all') All
          button.btn.btn-outline-success(data-filter='pending') Pending
          button.btn.btn-outline-success(data-filter='processing') Processing
          button.btn.btn-outline-success(data-filter='completed') Completed

      include includes/flash-messages.pug

      if orders && orders.length
        // Orders List
        .row.g-4
          each order in orders
            .col-12
              .card.shadow-sm.border-0.order-card(data-status=order.status)
                .card-body
                  .row
                    .col-md-8
                      .d-flex.justify-content-between.align-items-start.mb-3
                        div
                          h5.mb-1
                            | Order ##{order._id.toString().slice(-6).toUpperCase()}
                          p.text-muted.small.mb-0
                            i.fas.fa-calendar.me-1
                            | #{new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                        div
                          case order.status
                            when 'pending'
                              span.badge.bg-warning.text-dark
                                i.fas.fa-clock.me-1
                                | Pending
                            when 'processing'
                              span.badge.bg-info
                                i.fas.fa-spinner.me-1
                                | Processing
                            when 'completed'
                              span.badge.bg-success
                                i.fas.fa-check.me-1
                                | Completed
                            when 'cancelled'
                              span.badge.bg-danger
                                i.fas.fa-times.me-1
                                | Cancelled
                            default
                              span.badge.bg-secondary= order.status
                      
                      .mb-3
                        h6.mb-2 Items:
                        each item in order.items
                          .d-flex.align-items-center.mb-2
                            .flex-grow-1
                              span.fw-bold #{item.product ? item.product.productName : 'Product'}
                              span.text-muted.ms-2 × #{item.quantity}
                            span.text-success.fw-bold UGX #{(item.price * item.quantity).toLocaleString()}
                      
                      if order.shippingAddress
                        p.mb-2
                          i.fas.fa-map-marker-alt.me-2.text-muted
                          small.text-muted #{order.shippingAddress}
                    
                    .col-md-4.text-md-end
                      .border-start.ps-md-4.h-100.d-flex.flex-column.justify-content-between
                        div
                          p.text-muted.small.mb-1 Total Amount
                          h3.text-success.mb-3 UGX #{order.totalAmount.toLocaleString()}
                          
                          if order.paymentMethod
                            p.mb-2
                              i.fas.fa-credit-card.me-2.text-muted
                              small.text-muted #{order.paymentMethod}
                        
                        .d-grid.gap-2
                          a.btn.btn-outline-primary(href=`/order-detail/${order._id}`)
                            i.fas.fa-eye.me-2
                            | View Details
                          if order.status === 'pending'
                            button.btn.btn-success(onclick=`updateOrderStatus('${order._id}', 'processing')`)
                              i.fas.fa-check.me-2
                              | Accept Order
      else
        .text-center.py-5
          i.fas.fa-shopping-bag.fa-5x.text-muted.mb-4
          h3 No Orders Yet
          p.text-muted.mb-4 Orders from customers will appear here
          a.btn.btn-success.btn-lg(href='/product')
            i.fas.fa-shopping-basket.me-2
            | Browse Products

    include includes/footer.pug

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js')
    script.
      // Filter orders
      const filterBtns = document.querySelectorAll('[data-filter]');
      const orderCards = document.querySelectorAll('.order-card');
      
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const filter = this.dataset.filter;
          
          // Update active button
          filterBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          
          // Filter orders
          orderCards.forEach(card => {
            if (filter === 'all' || card.dataset.status === filter) {
              card.closest('.col-12').style.display = '';
            } else {
              card.closest('.col-12').style.display = 'none';
            }
          });
        });
      });
      
      function updateOrderStatus(orderId, status) {
        if (confirm('Update this order status?')) {
          fetch(`/orders/${orderId}/status`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ status: status })
          })
          .then(response => {
            if (response.ok) {
              window.location.reload();
            } else {
              alert('Failed to update order');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('Error updating order');
          });
        }
      }

