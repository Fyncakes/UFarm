nav.navbar.navbar-expand-lg.navbar-light.bg-white.shadow-sm
  .container
    a.navbar-brand(href='/')
      strong.text-success U
      | farm
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNav' aria-controls='navbarNav' aria-expanded='false' aria-label='Toggle navigation')
      span.navbar-toggler-icon
    #navbarNav.collapse.navbar-collapse
      ul.navbar-nav.ms-auto
        li.nav-item
          a.nav-link(href='/product') 
            i.fas.fa-shopping-basket.me-1
            | Products
        li.nav-item
          a.nav-link(href='/categories') 
            i.fas.fa-list.me-1
            | Categories
        li.nav-item
          a.nav-link(href='/about') 
            i.fas.fa-info-circle.me-1
            | About
        if user
          li.nav-item
            a.nav-link(href='/wishlist') 
              i.fas.fa-heart.me-1
              | Wishlist
          li.nav-item
            a.nav-link(href='/cart') 
              i.fas.fa-shopping-cart.me-1
              | Cart
          li.nav-item
            a.nav-link(href='/orders') 
              i.fas.fa-box.me-1
              | Orders
          li.nav-item.dropdown
            a.nav-link.dropdown-toggle(href='#' id='navbarDropdown' role='button' data-bs-toggle='dropdown' aria-expanded='false')
              i.fas.fa-user.me-1
              | #{user.Name1}
            ul.dropdown-menu(aria-labelledby='navbarDropdown')
              if user.role === 'Urban farmer'
                li
                  a.dropdown-item(href='/UB') Dashboard
              else if user.role === 'Farmer one'
                li
                  a.dropdown-item(href='/FO') Dashboard
              else if user.role === 'Agriculture Officer'
                li
                  a.dropdown-item(href='/OA') Dashboard
              li
                a.dropdown-item(href='/profile') Profile
              li
                hr.dropdown-divider
              li
                form(action='/logout' method='post')
                  button.dropdown-item(type='submit') Logout
        else
          li.nav-item
            a.nav-link(href='/Register')
              i.fas.fa-user-plus.me-1
              | Sign Up
          li.nav-item
            a.btn.btn-success.ms-2(href='/login')
              i.fas.fa-sign-in-alt.me-1
              | Login

